POSTGRES_DB=finance
POSTGRES_USER=finance
POSTGRES_PASSWORD=finance

# API uses this to talk to the db container
DATABASE_URL=postgresql+psycopg2://finance:finance@db:5432/finance

# Dashboard uses this to talk to the api container
API_BASE_URL=http://api:8000

# API key for authentication (leave empty to disable auth)
API_KEY=change-me-to-a-real-secret
